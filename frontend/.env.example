# Where the PrimeDrive API is.
#   AWS:   the ApiUrl output of the CDK stack, for example
#          https://abc123.execute-api.eu-central-1.amazonaws.com/prod/
#   Local: http://localhost:8080 (`make local-api`)
NEXT_PUBLIC_ENDPOINT=

# Local development only: start signed in as this user, without a sign-in.
# Leave it unset against AWS, where users sign in through Cognito.
# `make local-web` sets both variables for you.
NEXT_PUBLIC_LOCAL_USER=
